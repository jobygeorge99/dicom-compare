# Copy this file to `.env` and change the values.
# `.env` is git-ignored: real secrets never go into git.
# This example file IS committed, so teammates know which settings exist.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=dicom
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dicom_compare
POSTGRES_PORT=5432

# --- Backend (read by app/core/config.py) ---
APP_ENV=local
DATABASE_URL=postgresql+psycopg://dicom:change-me-locally@localhost:5432/dicom_compare

# Signs login tokens. Anyone with this key can forge an admin token.
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=paste-a-long-random-value-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
